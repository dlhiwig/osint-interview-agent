# === LLM providers (at least one is required, unless provider=ollama) ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# === Search backends (any subset; missing keys disable the corresponding tool) ===
PERPLEXITY_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=

# === Public records ===
# Free key from https://api.data.gov/signup/
FEC_API_KEY=
# SEC EDGAR requires a descriptive User-Agent with a contact email per their fair-access policy.
# Example: "Jane Doe jane@example.com"
SEC_EDGAR_USER_AGENT=
# Optional; without it OpenCorporates returns limited results.
OPENCORPORATES_API_KEY=
# Optional; GitHub rate limit jumps from 60/hr to 5000/hr when a token is present.
GITHUB_TOKEN=
# Optional; placed in the Crossref User-Agent for their "polite pool".
MAILTO=

# === Agent configuration ===
OSINT_LLM_PROVIDER=openai         # openai | anthropic | ollama
OSINT_LLM_MODEL=gpt-4o
# Optional: override the LLM base URL (also used when provider=ollama).
# OSINT_LLM_BASE_URL=
OSINT_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OSINT_MAX_TOOL_TURNS=20
OSINT_TOOL_WORKERS=4              # concurrent tool executions per turn
OSINT_ENABLE_CACHE=true           # cache repeated (tool, args) within a session
OSINT_REPORT_DIR=reports
OSINT_LOG_LEVEL=INFO
